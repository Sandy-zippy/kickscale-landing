.logo-marquee{
overflow:hidden;
width:100%;
/* background:#fff; */
padding:20px 0;
}

.logo-track{
display:flex;
align-items:center;
gap:60px;
width:max-content;
animation:logoslider 40s linear infinite;
}

.logo-track img{
height:auto;
width:auto;
transition:0.3s;
}

.logo-track img:hover{
transform:scale(1.1);
}

@keyframes logoslider{
0%{transform:translateX(0);}
100%{transform:translateX(-50%);}
}		</style>
